# Sortie Starter — what never goes in the repo
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store
*.log
tmp/
_to_delete/

# Release artifacts are produced by scripts/package.sh, never committed
dcs-mission-starter-*.zip
*.tgz

# Curated mission packs are delivered through /admin uploads (see
# tests/test_pack_delivery.py) — the producer lives in scripts/, the
# .sspack files do not live in git.
packs/


# Runtime state written by the server (analytics, uploads, sponsor store) — never source
instance/

# Recovery evidence kept beside the working tree in Dropbox, never source
_recovery/

# Local validation evidence and release bundles.
outputs/
