  "layouts": {
    "recovery": {
      "label": "Recovery — LA clear, deck spotted forward",
      "fill_zones": ["point", "crotch", "bow_stbd", "sixpack", "street", "corral",
                     "junkyard", "fantail_stbd", "el1", "el2", "el3"],
      "note": "Cyclic recovery: everything inside the LA foul lines is clear, including the waist cats, EL4, and the port stern (the ramp). Recovered jets get spotted forward: the point, the crotch, and the starboard bow rows in a herringbone, six-pack nose-in to the island, helos in the corral, tails over the round-down on the starboard fantail corner only."
    },
    "launch": {
      "label": "Launch — cats and taxi flow clear, deck spotted aft",
      "fill_zones": ["sixpack", "street", "corral", "junkyard",
                     "fantail_stbd", "el2", "el3"],
      "note": "Launch cycle: bow cat tracks, JBDs, the crotch, and the point are clear for cat 1/2 ops and taxi flow; the LA stays clear for the waist cats. Non-flying spares hold in the six-pack, the street, the junkyard, and the starboard fantail. EL1 and EL4 are not used adjacent to active cats."
    },
    "packed": {
      "label": "Packed deck — port visit / no-fly, LA fouled",
      "fill_zones": ["point", "crotch", "bow_stbd", "sixpack", "street", "corral",
                     "junkyard", "fantail_stbd", "fantail_port", "angle",
                     "el1", "el2", "el3", "el4"],
      "note": "No flight ops: the landing area and all four elevators are fouled with parked aircraft, herringbone rows down the angle. Do not fly from this deck."
    }
  }
