  "layouts": {
    "underway": {
      "label": "Underway — cruise deck, light park aft of the island",
      "fill_zones": ["sixpack", "street", "corral", "el2", "el3"],
      "note": "Transit/cruise: bow, cats, and LA all clear; a light park aft of the island. On Supercarrier hulls this uses editor-measured positions (Redkite data); on other hulls a light zone fill."
    },
    "recovery": {
      "label": "Recovery — LA clear, bow packed in tight rows",
      "fill_zones": ["point", "bow_row_stbd", "bow_row_cat1", "bow_row_cat2",
                     "sixpack", "street", "corral", "junkyard", "fantail_stbd",
                     "el1", "el2", "el3"],
      "note": "Cyclic recovery: everything inside the LA foul lines clear (waist cats, EL4, port stern ramp). The bow is the pack: three tight rows at uniform 40deg herringbone across the cat tracks and the starboard edge, E-2s nose-out on the point, six-pack nose-in, helos in the corral, tails over the round-down on the stbd fantail only."
    },
    "launch": {
      "label": "Launch — cats and taxi flow clear, deck spotted aft",
      "fill_zones": ["sixpack", "street", "corral", "junkyard",
                     "fantail_stbd", "el2", "el3"],
      "note": "Launch cycle: bow cat tracks, JBDs, the point, and the LA clear; spares hold aft in uniform rows. EL1/EL4 not used adjacent to active cats."
    },
    "packed": {
      "label": "Packed deck — port visit / no-fly, LA fouled",
      "fill_zones": ["point", "bow_row_stbd", "bow_row_cat1", "bow_row_cat2",
                     "sixpack", "street", "corral", "junkyard", "fantail_stbd",
                     "fantail_port", "angle", "el1", "el2", "el3", "el4"],
      "note": "No flight ops: LA fouled with a herringbone row down the angle, all four elevators loaded."
    }
  }
